# .env olarak kopyalayın. Bu dosya paylaşılmaz (.gitignore).
# OpenAI uyumlu sunucu adresi, sürüm yolu dahil (ör. http://llm.sirket.local/v1)
LLM_BASE_URL=
# Anahtar (sunucu istemiyorsa boş bırakın). Anahtarın tamamını yazın, öneki dahil.
LLM_API_KEY=
# /models listesindeki adlar birebir (python -m reqtestgen check ile görün)
LLM_CHAT_MODEL=
# Opsiyonel: embedding modeli yoksa boş bırakın (kelime tabanlı BM25 arama kullanılır)
LLM_EMBED_MODEL=
LLM_JUDGE_MODEL=
# Opsiyonel: kurum içi sertifika (PEM). Boşsa işletim sistemi sertifika deposu kullanılır.
LLM_CA_BUNDLE=
